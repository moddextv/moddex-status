{
  "name": "moddex-status",
  "version": "0.2.1",
  "private": true,
  "description": "Uptime and health for the moddex services, served at status.moddex.tv",
  "type": "module",
  "engines": {
    "node": ">=23.4"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "dev": "node --watch src/index.js",
    "format": "npx --yes prettier@3.9.6 --write .",
    "format:check": "npx --yes prettier@3.9.6 --check ."
  },
  "dependencies": {}
}
