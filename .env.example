# cp .env.example .env — alle Werte haben Vorgaben, die Datei muss nur existieren

PORT=4002

CHECK_INTERVAL_MS=60000
CHECK_TIMEOUT_MS=5000

DB_PATH=./data/status.db

HISTORY_HOURS=72

RETAIN_DAYS=90
RAW_RETAIN_HOURS=168

INCIDENT_WINDOW_HOURS=72
INCIDENT_LIMIT=6

MONITOR_WEB_URL=https://moddex.tv/health
MONITOR_API_URL=https://api.moddex.tv/health
MONITOR_WS_URL=https://ws.moddex.tv/health

MONITOR_EVENTSUB_URL=https://api.moddex.tv/v1/eventsub/health

IMAGE=ghcr.io/moddextv/moddex-status
IMAGE_TAG=latest